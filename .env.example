# Copy to .env and fill in. .env is git-ignored.
ZEPP_EMAIL=you@example.com
ZEPP_PASSWORD=your-zepp-password

# Optional. Two-letter country used at login; the server reads the account's
# real region back out of the login response regardless.
ZEPP_COUNTRY=US

# Optional. Path for the API token cache (default ~/.zepp-mcp/token.json).
# Set to "off" to disable caching and log in on every start -- note that
# failed logins count toward a shared 10-attempt account lockout.
# ZEPP_TOKEN_CACHE=off

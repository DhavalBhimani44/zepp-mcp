# Copy to .env and fill in. .env is git-ignored — never commit it.
#
# These are your real Zepp/Amazfit app credentials. probe.py sends them to
# Zepp's own login endpoint (AES-encrypted, exactly as the mobile app does)
# and nowhere else. A real environment variable overrides anything here.
ZEPP_EMAIL=you@example.com
ZEPP_PASSWORD=your-zepp-password

# Optional. Leave unset unless you already know your account's region —
# probe.py discovers it by trying five login variants in order.
# ZEPP_COUNTRY=IN
